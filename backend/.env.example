# Railway (Express API — all server secrets live here)

# MongoDB Atlas — database name: lelek_studio
DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/lelek_studio?retryWrites=true&w=majority"

# JWT signing for admin sessions (min 64 random chars)
JWT_SECRET="generate-a-long-random-string-at-least-64-characters-for-production"

# One-time DB seed: GET /setup/seed?secret=YOUR_VALUE
SETUP_SECRET="random-secret-for-one-time-seed"

# Resend — contact form notifications
RESEND_KEY="re_xxxxxxxx"
ADMIN_EMAIL="lelekstudio@lelekstudio.com"

# Vercel frontend URL (CORS + shared auth cookie domain)
FRONTEND_URL="https://www.lelekstudio.com"

# Must match Vercel REVALIDATE_SECRET - backend POSTs to FRONTEND_URL/api/revalidate after admin writes
REVALIDATE_SECRET=""

# Railway sets PORT automatically
# PORT=3001
