# MongoDB Atlas - copy from Railway/Atlas, change database to lelek_studio
DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/lelek_studio?retryWrites=true&w=majority"

# Auth (min 64 random chars)
JWT_SECRET="generate-a-long-random-string-at-least-64-characters-for-production"

# Email (Resend)
RESEND_KEY="re_xxxxxxxx"
ADMIN_EMAIL="lelekstudio@lelekstudio.com"

# Hidden registration - comma-separated allowed emails
ALLOWED_REGISTER_EMAILS="lelekstudio@lelekstudio.com"

# Optional: secret query param for /api/setup/seed (one-time DB seed on Vercel)
SETUP_SECRET="random-secret-for-one-time-seed"

# Site
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Production uploads (Vercel Blob - Phase 8)
# BLOB_READ_WRITE_TOKEN=""
