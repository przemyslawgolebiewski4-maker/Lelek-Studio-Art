# Vercel (Next.js frontend only — no database secrets here)

# Railway API base URL (must include https://)
NEXT_PUBLIC_API_URL="https://lelek-studio-art-production.up.railway.app"

# Public site URL (canonical domain for metadata, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL="https://www.lelekstudio.com"

# Shop destination (nav + CTAs read this; no hardcoded shop URLs in components)
# TEMPORARY: points to Etsy until Shopify store is live - swap to shop.lelekstudio.com when ready
NEXT_PUBLIC_SHOP_URL="https://lelekstudio.etsy.com"

# Admin media upload (Vercel Blob — create store in Vercel dashboard → Storage)
BLOB_READ_WRITE_TOKEN=""

# On-demand ISR revalidation (Vercel + Railway must share the same secret)
# Set in Vercel env vars; Railway backend POSTs to /api/revalidate?secret=...
REVALIDATE_SECRET=""
