# MongoDB Atlas - same cluster as aruru, database name: lelek_studio
DATABASE_URL="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/lelek_studio?retryWrites=true&w=majority"

# Auth (min 64 random chars) - Phase 2
JWT_SECRET="generate-a-long-random-string-at-least-64-characters-for-production"

# Email (Resend) - Phase 7
RESEND_KEY="re_xxxxxxxx"
ADMIN_EMAIL="lelekstudio@lelekstudio.com"

# Hidden registration - comma-separated allowed emails - Phase 2
ALLOWED_REGISTER_EMAILS="lelekstudio@lelekstudio.com"

# Secret query param for /api/setup/seed (one-time DB seed)
SETUP_SECRET="random-secret-for-one-time-seed"

# Public site URL (production domain)
NEXT_PUBLIC_SITE_URL="https://www.lelekstudio.com"

# Railway sets PORT automatically - do not override unless needed
# PORT=3000

# Production uploads - Phase 8
# BLOB_READ_WRITE_TOKEN=""
